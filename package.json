{
  "name": "project-saturn",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter web build",
    "dev": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "db:push": "pnpm --filter api db:push",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "three": "^0.180.0"
    }
  }
}
