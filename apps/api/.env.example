DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
APP_ORIGIN="http://localhost:3000"
PORT=4000
# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Email delivery for magic links (first configured wins; none = dev mode returns the link)
RESEND_API_KEY=
EMAIL_FROM="Saturn <no-reply@example.com>"
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Single sign-on (OpenID Connect): Google, Microsoft Entra, Okta, Auth0, Keycloak
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL="Sign in with company account"
OIDC_ALLOWED_DOMAINS=
OIDC_ORG_ID=
API_ORIGIN=http://localhost:4000
# Real-time co-editing is served on the same port at ws://host/rt/<projectId>?token=<session>
